    <!-- Sticky Mobile CTA Bar (Hidden on desktop) -->
    <div class="hidden md:flex fixed bottom-0 left-0 right-0 bg-amber-600 text-white px-4 py-3 justify-between items-center z-50">
        <a href="tel:+15550192834" class="flex items-center space-x-2 text-amber-200 hover:text-amber-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-0.502 1.21l-2.257 1.13a11.042 11.042 0 015.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 5 16.284 5 11V5a2 2 0 012-2z" />
            </svg>
            Call Now
        </a>
        <a href="#cost-calculator" class="bg-amber-500 text-white px-5 py-2 rounded-md hover:bg-amber-600 transition-colors">
            Get Quote
        </a>
    </div>

    <script>
        // Mobile Menu Toggle
        document.getElementById('mobile-menu-button').addEventListener('click', function() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        });

        // Before/After Slider
        const sliderHandle = document.getElementById('slider-handle');
        const beforeAfterContainer = sliderHandle.parentElement;
        let isDragging = false;

        sliderHandle.addEventListener('mousedown', (e) => {
            isDragging = true;
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            const rect = beforeAfterContainer.getBoundingClientRect();
            let x = e.clientX - rect.left;
            const width = rect.width;
            x = Math.max(0, Math.min(x, width));
            const percentage = (x / width) * 100;
            sliderHandle.style.left = `${percentage}%`;
            beforeAfterContainer.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
        });

        document.addEventListener('mouseup', () => {
            isDragging = false;
        });

        // Touch support for mobile
        sliderHandle.addEventListener('touchstart', (e) => {
            isDragging = true;
            e.preventDefault();
        });

        document.addEventListener('touchmove', (e) => {
            if (!isDragging) return;
            const rect = beforeAfterContainer.getBoundingClientRect();
            let x = e.touches[0].clientX - rect.left;
            const width = rect.width;
            x = Math.max(0, Math.min(x, width));
            const percentage = (x / width) * 100;
            sliderHandle.style.left = `${percentage}%`;
            beforeAfterContainer.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
        });

        document.addEventListener('touchend', () => {
            isDragging = false;
        });

        // Cost Calculator
        const areaSlider = document.getElementById('area-slider');
        const areaValue = document.getElementById('area-value');
        const costRange = document.getElementById('cost-range');
        const calculatorForm = document.getElementById('calculator-form');

        function calculateCost() {
            const area = parseInt(areaSlider.value);
            const projectType = document.querySelector('input[name="projectType"]:checked').value;
            const condition = document.querySelector('input[name="condition"]:checked').value;

            // Base price per sq.ft (these are example ranges)
            let basePricePerSqFt = 0;
            if (projectType === 'epoxy') {
                basePricePerSqFt = condition === 'good' ? 3 : condition === 'minor' ? 4 : 5;
            } else if (projectType === 'waterproofing') {
                basePricePerSqFt = condition === 'good' ? 8 : condition === 'minor' ? 10 : 12;
            } else { // both
                basePricePerSqFt = condition === 'good' ? 10 : condition === 'minor' ? 13 : 16;
            }

            const minPrice = Math.round(area * basePricePerSqFt * 0.8); // 80% of base for range
            const maxPrice = Math.round(area * basePricePerSqFt * 1.2); // 120% of base for range

            costRange.textContent = `$${minPrice.toLocaleString()} - $${maxPrice.toLocaleString()}`;
        }

        // Update area value display
        areaSlider.addEventListener('input', () => {
            areaValue.textContent = areaSlider.value;
            calculateCost();
        });

        // Recalculate when project type or condition changes
        document.querySelectorAll('input[name="projectType"], input[name="condition"]').forEach(input => {
            input.addEventListener('change', calculateCost);
        });

        // Initial calculation
        calculateCost();

        // Form submission (for demo, we'll just show an alert)
        calculatorForm.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Thank you for your interest! We will contact you shortly to schedule your on-site inspection.');
            calculatorForm.reset();
            calculateCost(); // Reset calculation
        });

        // Lead form submission
        const leadForm = document.getElementById('lead-form');
        leadForm.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Thank you for your submission! We will review your information and contact you shortly.');
            leadForm.reset();
        });

        // FAQ Accordion
        const faqItems = [
            { id: 1, question: document.getElementById('faq-1'), answer: document.getElementById('faq-1-answer'), icon: document.getElementById('faq-1-icon') },
            { id: 2, question: document.getElementById('faq-2'), answer: document.getElementById('faq-2-answer'), icon: document.getElementById('faq-2-icon') },
            { id: 3, question: document.getElementById('faq-3'), answer: document.getElementById('faq-3-answer'), icon: document.getElementById('faq-3-icon') }
        ];

        faqItems.forEach(item => {
            item.question.addEventListener('click', () => {
                const isOpen = !item.answer.classList.contains('hidden');
                item.answer.classList.toggle('hidden', !isOpen);
                item.icon.classList.toggle('rotate-180', !isOpen);
            });
        });

        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>
</html>